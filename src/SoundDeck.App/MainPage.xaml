<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SoundDeck_App.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SoundDeck_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#0B0B13"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Background="#11111D" BorderBrush="#27273A" BorderThickness="0,0,1,0">
            <Grid Padding="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="36" Height="36" Background="#7C3AED" CornerRadius="10">
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE767;" />
                    </Border>
                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="SoundDeck" />
                        <TextBlock Foreground="#9494AA" Text="Panel de sonidos" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,10">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="TABLEROS" />
                    <Button HorizontalAlignment="Right"
                            Command="{Binding AddBoardCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Añadir tablero">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding Boards}"
                          SelectedItem="{Binding SelectedBoard, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="3" Padding="12" Background="#191927" CornerRadius="10">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Atajos activos" />
                        <TextBlock Foreground="#9494AA" Text="Detener: Ctrl + Shift + Esc" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Padding="28,18,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="26" FontWeight="SemiBold"
                               Text="{Binding SelectedBoard.Name, FallbackValue=Mi tablero}" />
                    <TextBlock Foreground="#9494AA" Text="Pulsa un botón o usa su atajo global" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Click="ImportSound_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="13" Glyph="&#xE8E5;" />
                            <TextBlock Text="Añadir sonido" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}" ToolTipService.ToolTip="Detener sonido">
                        <FontIcon Glyph="&#xE71A;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,22,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Buscar sonidos…"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown" />
                <ComboBox Grid.Column="1" Margin="12,0,0,0"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding Categories}"
                          PlaceholderText="Todas las categorías"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          SelectionChanged="Category_SelectionChanged" />
                <Button Grid.Column="2" Margin="8,0,0,0"
                        Command="{Binding AddCategoryCommand}"
                        ToolTipService.ToolTip="Añadir categoría">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
                <TextBlock Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="#9494AA" Text="{Binding Sounds.Count}" />
            </Grid>

            <GridView Grid.Row="2"
                      AllowDrop="True"
                      CanDragItems="True"
                      CanReorderItems="True"
                      DragItemsCompleted="Sounds_DragItemsCompleted"
                      IsItemClickEnabled="False"
                      ItemsSource="{Binding Sounds}"
                      SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="178" Height="150" Margin="0,0,14,14"
                                Background="#181827" BorderBrush="#2A2A40" BorderThickness="1" CornerRadius="14">
                            <Grid>
                                <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.PlayCommand, ElementName=RootPage}"
                                        CommandParameter="{Binding}">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10">
                                        <Border Width="48" Height="48" Background="#7C3AED" CornerRadius="14">
                                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      FontSize="20" Glyph="{Binding Icon}" />
                                        </Border>
                                        <TextBlock MaxWidth="140" FontSize="16" FontWeight="SemiBold"
                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon FontSize="11" Glyph="&#xE995;" />
                                            <TextBlock FontSize="11" Foreground="#A4A4B8" Text="{Binding Route}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                        Background="#6611111D" Tag="{Binding}" ToolTipService.ToolTip="Opciones">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="EditSound_Click" Tag="{Binding}" Text="Editar">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="NormalizeSound_Click" Tag="{Binding}" Text="Normalizar volumen">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="LearnMidi_Click" Tag="{Binding}" Text="Aprender MIDI">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D4;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="DeleteSound_Click" Tag="{Binding}" Text="Eliminar">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <InfoBar Grid.Row="3" Margin="0,10,0,0" IsOpen="True" IsClosable="False"
                     Message="{Binding StatusMessage}" Severity="Informational" />
        </Grid>

        <Border Grid.Column="2" Background="#11111D" BorderBrush="#27273A" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Padding="22" Spacing="14">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="Mezclador" />

                    <Border Padding="14" Background="#191927" CornerRadius="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock FontWeight="SemiBold" Text="Micrófono" />
                                <ToggleSwitch HorizontalAlignment="Right"
                                              IsOn="{Binding MicrophoneMuted, Mode=TwoWay}"
                                              OffContent="" OnContent="Mute" />
                            </Grid>
                            <ComboBox DisplayMemberPath="Name"
                                      ItemsSource="{Binding Microphones}"
                                      SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}" />
                            <ProgressBar Height="4" Maximum="100" Value="{Binding MicrophoneLevel}" />
                            <Slider Header="Volumen" Maximum="200"
                                    Value="{Binding MicrophoneVolume, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Salida local" />
                    <ComboBox DisplayMemberPath="Name"
                              ItemsSource="{Binding LocalOutputs}"
                              SelectedItem="{Binding SelectedLocalOutput, Mode=TwoWay}" />

                    <TextBlock FontWeight="SemiBold" Text="Salida virtual" />
                    <ComboBox DisplayMemberPath="Name"
                              ItemsSource="{Binding VirtualOutputs}"
                              SelectedItem="{Binding SelectedVirtualOutput, Mode=TwoWay}" />

                    <Border Padding="14" Background="#191927" CornerRadius="12">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Foreground="#A78BFA" Glyph="&#xE946;" />
                                <TextBlock FontWeight="SemiBold" Text="VB-CABLE" />
                            </StackPanel>
                            <TextBlock Foreground="#A4A4B8" TextWrapping="Wrap"
                                       Text="Selecciona CABLE Output como entrada en Discord y juegos." />
                            <HyperlinkButton Content="Abrir guía de configuración"
                                             NavigateUri="https://vb-audio.com/Cable/" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Control MIDI" />
                    <ComboBox ItemsSource="{Binding MidiDevices}"
                              PlaceholderText="Selecciona un dispositivo"
                              SelectedItem="{Binding SelectedMidiDevice, Mode=TwoWay}" />

                    <ToggleSwitch Header="Iniciar con Windows"
                                  IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Biblioteca" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="Backup_Click" Content="Crear copia" />
                        <Button Click="Restore_Click" Content="Restaurar" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
